[Unit]
Description=Laravel queue worker (erp-laravel)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/erp-laravel
ExecStart=/usr/bin/php /var/www/erp-laravel/artisan queue:work --sleep=3 --tries=3 --max-time=3600
StandardOutput=append:/var/www/erp-laravel/storage/logs/queue-worker.log
StandardError=append:/var/www/erp-laravel/storage/logs/queue-worker.log

[Install]
WantedBy=multi-user.target
